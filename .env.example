# ============================================================================
# Environment configuration for GROK.IDE
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- Server -----------------------------------------------------------------

# TCP port the server listens on. Required.
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Set to "true" to have the API server also serve the built AI IDE frontend.
# Always true inside Docker (set in Dockerfile). Set false if you serve the
# frontend separately (e.g. via Nginx or a CDN).
SERVE_FRONTEND=false

# --- Database ---------------------------------------------------------------

# PostgreSQL connection string. Required in production.
# With docker-compose.yml, DATABASE_URL is derived from the POSTGRES_* values
# below — only set this directly when running the server outside Docker.
DATABASE_URL=postgres://app:choose-a-strong-password@localhost:5432/app

# --- Security ---------------------------------------------------------------

# Random secret used to sign sessions/tokens. Required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-random-secret

# Allowed CORS origins (comma-separated). Optional.
# Development default: all origins allowed.
# Production default (when unset): all cross-origin requests blocked.
# Example: CORS_ORIGIN=https://app.example.com,https://www.example.com
# CORS_ORIGIN=

# --- AI (xAI / Grok) --------------------------------------------------------

# xAI API key for Grok AI features.
# Required when running OUTSIDE Replit. Obtain at https://console.x.ai
# Inside Replit the GitHub integration handles authentication automatically.
# XAI_API_KEY=xai-...

# --- GitHub integration ------------------------------------------------------

# GitHub personal access token with repo/contents write permission.
# Required when running OUTSIDE Replit for the GitHub push feature.
# Create a fine-grained PAT at https://github.com/settings/tokens
# with Read and Write access to "Contents" on your target repositories.
# Inside Replit the GitHub integration handles authentication automatically.
# GITHUB_TOKEN=github_pat_...

# --- Docker Compose (used only by docker-compose.yml) -----------------------

# Credentials for the Postgres container. POSTGRES_PASSWORD has no default —
# docker compose fails fast if it is unset. Use a strong random value.
POSTGRES_USER=app
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=app
