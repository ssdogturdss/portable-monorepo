# ============================================================================
# Environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- API server -------------------------------------------------------------

# TCP port the API server listens on. Required.
PORT=3000

# Node environment: development | production
NODE_ENV=development

# --- Database ---------------------------------------------------------------

# PostgreSQL connection string. Required in production; only needed in
# development when database features are used.
# With the provided docker-compose.yml, DATABASE_URL is derived automatically
# from the POSTGRES_* values below — you only need to set it here when running
# the server outside Docker.
DATABASE_URL=postgres://app:choose-a-strong-password@localhost:5432/app

# --- Security ---------------------------------------------------------------

# Random secret used to sign sessions/tokens. Required in production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-random-secret

# --- Docker Compose (used only by docker-compose.yml) -----------------------

# Credentials for the Postgres container. POSTGRES_PASSWORD has no default —
# docker compose fails fast if it is unset. Use a strong value on servers.
POSTGRES_USER=app
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=app
